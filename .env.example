# ─── Hedera ───────────────────────────────────────────────────────────────
HEDERA_NETWORK=testnet
# Gateway operator (ECDSA): pays HCS fees + gas. Never holds customer funds.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# Merchant settlement account: customer payments land here directly.
MERCHANT_ACCOUNT_ID=
# HTS token accepted at checkout (e.g. testnet USDC 0.0.429274). Empty = HBAR only.
PAYMENT_TOKEN_ID=
# Contract deployed by `yarn hardhat:deploy --network hederaTestnet`
INVOICE_REGISTRY_ADDRESS=
# HCS topic for settlement receipts (created by `yarn reconciler:once --init-topic`)
HCS_RECEIPT_TOPIC_ID=

# ─── Ledger (Postgres from docker compose) ────────────────────────────────
DATABASE_URL=postgresql://merchant:merchant@localhost:5432/merchant_payments

# ─── Webhooks ─────────────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=whsec_dev_change_me
# Merchant endpoint that receives invoice.paid / invoice.expired
MERCHANT_WEBHOOK_URL=

# ─── Worker ───────────────────────────────────────────────────────────────
RECONCILE_POLL_MS=5000
RECONCILE_LOOKBACK_SECONDS=3600

# ─── Optional RPC override ────────────────────────────────────────────────
HEDERA_RPC_URL=https://testnet.hashio.io/api
