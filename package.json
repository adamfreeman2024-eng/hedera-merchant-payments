{
  "name": "hedera-merchant-payments",
  "version": "0.1.0",
  "private": true,
  "description": "Non-custodial merchant payment gateway for Hedera: on-chain invoices, HTS/HBAR settlement, Mirror Node reconciliation, HCS receipts, webhooks.",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.3"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "packageManager": "yarn@3.2.3",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "ledger:up": "docker compose up -d postgres",
    "ledger:down": "docker compose down",
    "db:generate": "yarn workspace @hmp/ledger prisma:generate",
    "db:migrate": "yarn workspace @hmp/ledger prisma:migrate",
    "hardhat:compile": "yarn workspace @hmp/hardhat compile",
    "hardhat:test": "yarn workspace @hmp/hardhat test",
    "hardhat:deploy": "yarn workspace @hmp/hardhat deploy",
    "hardhat:verify:testnet": "yarn workspace @hmp/hardhat verify:testnet",
    "hardhat:verify:mainnet": "yarn workspace @hmp/hardhat verify:mainnet",
    "hardhat:chain": "yarn workspace @hmp/hardhat chain",
    "hardhat:account": "yarn workspace @hmp/hardhat account",
    "hardhat:account:generate": "yarn workspace @hmp/hardhat account:generate",
    "ledger:test": "yarn workspace @hmp/ledger test",
    "next:dev": "yarn workspace @hmp/nextjs dev",
    "next:build": "yarn workspace @hmp/nextjs build",
    "next:start": "yarn workspace @hmp/nextjs start",
    "reconciler:dev": "yarn workspace @hmp/reconciler dev",
    "reconciler:once": "yarn workspace @hmp/reconciler once",
    "smoke:testnet": "yarn db:generate && yarn workspace @hmp/reconciler smoke:testnet",
    "typecheck": "yarn db:generate && yarn hardhat:compile && yarn workspace @hmp/ledger typecheck && yarn workspace @hmp/hardhat check-types && yarn workspace @hmp/reconciler typecheck && yarn workspace @hmp/nextjs typecheck",
    "test": "yarn db:generate && yarn hardhat:test && yarn ledger:test",
    "verify": "yarn typecheck && yarn test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  }
}
