# Public values only — anything here is shipped to the browser.
# Contract address shown on the checkout page.
NEXT_PUBLIC_INVOICE_REGISTRY_ADDRESS=
# Merchant Hedera account id shown at checkout ("pay this account with this memo")
NEXT_PUBLIC_MERCHANT_ACCOUNT_ID=
# HTS token accepted at checkout (empty = HBAR only)
NEXT_PUBLIC_PAYMENT_TOKEN_ID=
# WalletConnect project id for HashPack/mobile wallets (https://cloud.reown.com)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# Hedera network the UI labels transactions with
NEXT_PUBLIC_HEDERA_NETWORK=testnet
